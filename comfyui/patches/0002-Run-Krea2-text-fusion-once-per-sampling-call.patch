From d9c150bd7dc1092ab18e386aa93af6ccc10171bd Mon Sep 17 00:00:00 2001
From: Luna Niemitalo <luna.niemitalo@gmail.com>
Date: Tue, 29 Sep 2026 02:41:13 +0300
Subject: [PATCH 2/5] Run Krea2 text fusion once per sampling call

The txtfusion + txtmlp path depends only on the text conditioning, but ran
on every step. Krea2.extra_conds now runs it once (inference mode only);
_forward still accepts the raw layer stack. Output bit-identical; 128x128
step 185.6 -> 165.3 ms.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 comfy/ldm/krea2/model.py | 14 +++++++++-----
 comfy/model_base.py      |  2 ++
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/comfy/ldm/krea2/model.py b/comfy/ldm/krea2/model.py
index 8001812d..8acfbcd5 100644
--- a/comfy/ldm/krea2/model.py
+++ b/comfy/ldm/krea2/model.py
@@ -301,9 +301,6 @@ class SingleStreamDiT(nn.Module):
         bs, _, h_orig, w_orig = x.shape
         patch = self.patch
 
-        # context arrives as (B, seq, txtlayers*txtdim); reshape to (B, txtlayers, seq, txtdim).
-        context = self._unpack_context(context)
-
         img, imgpos, h_, w_ = self.process_img(x)
         img_tokens = img.shape[1]
         timestep_zero_index = None
@@ -336,8 +333,9 @@ class SingleStreamDiT(nn.Module):
             t0 = self.tmlp(timestep_embedding(torch.zeros_like(timesteps), self.tdim).unsqueeze(1).to(img.dtype))
             tvec = torch.cat((tvec, self.tproj(t0)), dim=0)
 
-        context = self.txtfusion(context, mask=None, transformer_options=transformer_options)
-        context = self.txtmlp(context)
+        # Krea2.extra_conds already ran preprocess_text once per sampling call; raw stacks still arrive outside inference mode.
+        if context.shape[-1] != self.txtmlp[-1].out_features:
+            context = self.preprocess_text(context, transformer_options=transformer_options)
 
         txtlen = context.shape[1]
         device = context.device
@@ -379,6 +377,12 @@ class SingleStreamDiT(nn.Module):
             out = out.reshape(b5, t5, self.channels, h_orig, w_orig).movedim(1, 2)
         return out
 
+    def preprocess_text(self, context, transformer_options={}):
+        """Timestep-independent text path: (B, seq, txtlayers*txtdim) Qwen3-VL layer stack -> (B, seq, features)."""
+        context = self._unpack_context(context)
+        context = self.txtfusion(context, mask=None, transformer_options=transformer_options)
+        return self.txtmlp(context)
+
     def _unpack_context(self, context):
         # context: (B, seq, txtlayers*txtdim) -> (B, seq, txtlayers, txtdim).
         b, seq, fused = context.shape
diff --git a/comfy/model_base.py b/comfy/model_base.py
index 4f731e7c..49507c3e 100644
--- a/comfy/model_base.py
+++ b/comfy/model_base.py
@@ -2741,6 +2741,8 @@ class Krea2(BaseModel):
         out = super().extra_conds(**kwargs)
         cross_attn = kwargs.get("cross_attn", None)
         if cross_attn is not None:
+            if torch.is_inference_mode_enabled():  # if not we are training
+                cross_attn = self.diffusion_model.preprocess_text(cross_attn.to(device=kwargs["device"], dtype=self.get_dtype_inference()))
             out['c_crossattn'] = comfy.conds.CONDRegular(cross_attn)
         ref_latents = kwargs.get("reference_latents", None)
         if ref_latents is not None:
