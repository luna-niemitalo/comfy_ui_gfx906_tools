index 4ea7cbae..f6d81186 100644
--- a/comfy/model_management.py
+++ b/comfy/model_management.py
@@ -192,7 +192,9 @@ def is_wsl():
         return True
     return False
 
-def get_torch_device():
+def get_torch_device(force_cpu=False):
+    if force_cpu:
+        return torch.device("cpu")
     global directml_enabled
     global cpu_state
     if directml_enabled:
@@ -483,7 +485,9 @@ AMD_ENABLE_MIOPEN_ENV = 'COMFYUI_ENABLE_MIOPEN'
 
 try:
     if is_amd():
+        print("Checking AMD architecture for optimal settings...")
         arch = torch.cuda.get_device_properties(get_torch_device()).gcnArchName.split(':')[0]
+        print("Detected AMD architecture: {}".format(arch))
         if not (any((a in arch) for a in AMD_RDNA2_AND_OLDER_ARCH)):
             if os.getenv(AMD_ENABLE_MIOPEN_ENV) != '1':
                 torch.backends.cudnn.enabled = False  # Seems to improve things a lot on AMD
