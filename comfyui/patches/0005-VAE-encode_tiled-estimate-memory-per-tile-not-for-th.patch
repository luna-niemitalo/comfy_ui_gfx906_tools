From a78eae83b2e03b786c910c0dc8cba7ac1c0b2fc7 Mon Sep 17 00:00:00 2001
From: Luna Niemitalo <luna.niemitalo@gmail.com>
Date: Tue, 29 Sep 2026 17:40:15 +0300
Subject: [PATCH 5/5] VAE encode_tiled: estimate memory per tile, not for the
 whole image

Qwen-Image VAE at 2560x1440 asked load_models_gpu for 10.3 GB (fp16) / 20.6 GB
(fp32) before each tiled encode, evicting other models, while using < 1 GB.
Now 0.73 GB. decode_tiled already did this.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 comfy/sd.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/comfy/sd.py b/comfy/sd.py
index a7042623..f8c32b9c 100644
--- a/comfy/sd.py
+++ b/comfy/sd.py
@@ -1468,7 +1468,10 @@ class VAE:
             else:
                 pixel_samples = pixel_samples.unsqueeze(2)
 
-        memory_used = self.memory_used_encode(pixel_samples.shape, self.vae_dtype)  # TODO: calculate mem required for tile
+        # Per tile, like decode_tiled: the whole-image estimate asked for 10-20 GB at 2560x1440 (Wan 2.1 /
+        # Qwen-Image VAE) against < 1 GB actually used, evicting every other model on the device before each
+        # tiled encode (develop/experiments/2026-09-29/vae_mem_bench.py).
+        memory_used = self.memory_used_encode(self._tile_bounded_shape(pixel_samples.shape, tile_x, tile_y, tile_t), self.vae_dtype)
         model_management.load_models_gpu([self.patcher], memory_required=memory_used, force_full_load=self.disable_offload)
 
         args = {}
